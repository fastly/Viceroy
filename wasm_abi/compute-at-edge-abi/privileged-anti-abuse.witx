(module $fastly_privileged_anti_abuse
    ;;; Privileged hostcall intended for Fastly C@E A3F programs to verify
    ;;; HTTP requests.
    (@interface func (export "service_bot_verify")
        (param $jsonreq string)
        (param $timeout_ms u64)
        (param $buf (@witx pointer (@witx char8)))
        (param $buf_len (@witx usize))
        (param $nwritten_out (@witx pointer (@witx usize)))
        (result $err (expected (error $fastly_status)))
    )
)
